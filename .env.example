# Katharos Environment Configuration

# Database Credentials
POSTGRES_DB=katharos_db
POSTGRES_USER=katharos_user
POSTGRES_PASSWORD=katharos_secret

# Database Storage Path
# For Local Windows/Mac/Linux (Docker volume fallback):
# DB_DATA_PATH=katharos_db_data
# For TrueNAS Server Production:
# DB_DATA_PATH=/mnt/HDD2TB-Dual/AppData/katharos/db_data

# Backend API Configuration
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Development
VITE_BACKEND_URL=http://localhost:8080
